# Which provider extracts the intent: anthropic | openai | groq | gemini | ollama (local, no key)
LLM_PROVIDER=anthropic
# Optional: override the provider's default model
# LLM_MODEL=

# Set the key for the provider you chose (never commit a real key)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
